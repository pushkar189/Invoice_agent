# Server
PORT=5000
NODE_ENV=development

# Database — NeonDB PostgreSQL
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/neondb?sslmode=require&channel_binding=require

# Ollama (local — or http://host.docker.internal:11434 in Docker)
OLLAMA_URL=http://localhost:11434
MODEL_NAME=gemma4:12b

# JWT Secret — change this!
JWT_SECRET=change-this-to-a-strong-random-string-at-least-32-characters

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Financial Tolerance (₹)
FINANCIAL_TOLERANCE=0.01
